# --- Instanz / Domain -------------------------------------------------------
# Domain, unter der diese Instanz erreichbar ist (ohne Protokoll).
SITE_DOMAIN=example.org
DJANGO_ALLOWED_HOSTS=example.org,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.org

# Pflicht in Produktion (DJANGO_DEBUG=0): starker Zufallsstring, z. B.
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-strong-random-string
DJANGO_DEBUG=0

# --- Betreiber-Branding -----------------------------------------------------
# Name des Vereins/Anbieters (Seitentitel, Header, E-Mail-Betreff). Alternativ
# (oder zusätzlich) im Admin unter „Betreiber-Einstellungen" änderbar; das Logo
# wird dort als Datei hochgeladen und liegt dann unter media/ (nie im Repo).
SITE_NAME=Beispielverein
# SITE_NAME=... (Alias: ORGANIZATION_NAME wird ebenfalls akzeptiert)

# --- Datenbank ---------------------------------------------------------------
POSTGRES_DB=veranstaltungen
POSTGRES_USER=veranstaltungen
POSTGRES_PASSWORD=replace-with-strong-db-password

# --- E-Mail ------------------------------------------------------------------
# Konsole (Dev) oder smtp (Produktion)
EMAIL_BACKEND_MODE=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=veranstaltungen@example.org
# Empfänger für den gesammelten Fehlerbericht (send_error_report, alle 5 min)
ERROR_REPORT_EMAILS=

# --- Optionale Dienste -------------------------------------------------------
# Application Token aus https://boardgamegeek.com/applications
# (kurzform "BGG=" wird ebenfalls akzeptiert)
BGG_API_TOKEN=

# DeepL API key for shared German BGG descriptions (Free keys end in :fx).
DEEPL=

# --- Betreiberangaben für Impressum und Datenschutz --------------------------
# Personenbezogene Daten des Verantwortlichen - nur lokal in dieser Datei
# pflegen, niemals committen (.env ist gitignored).
IMPRINT_NAME=Vorname Nachname
IMPRINT_STREET=Straße Hausnummer
IMPRINT_CITY=PLZ Ort
IMPRINT_EMAIL=kontakt@example.org
